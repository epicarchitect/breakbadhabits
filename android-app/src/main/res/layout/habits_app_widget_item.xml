<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_frameLayout"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="2dp"
    android:paddingEnd="8dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/habitName_textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:lines="1"
        android:textAppearance="?android:attr/textAppearanceMedium"
        tools:text="Habit name" />

    <TextView
        android:id="@+id/habitStage_textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:lines="1"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:visibility="gone"
        tools:text="Rebuilding · 37 / 90" />

    <LinearLayout
        android:id="@+id/habitProgress_linearLayout"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/habitProgress1_progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="7"
            android:indeterminate="false"
            android:max="7"
            android:progress="0"
            android:progressBackgroundTint="@color/widget_progress_track"
            android:progressTint="@color/widget_progress" />

        <ProgressBar
            android:id="@+id/habitProgress2_progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="14"
            android:indeterminate="false"
            android:max="14"
            android:progress="0"
            android:progressBackgroundTint="@color/widget_progress_track"
            android:progressTint="@color/widget_progress" />

        <ProgressBar
            android:id="@+id/habitProgress3_progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="24"
            android:indeterminate="false"
            android:max="24"
            android:progress="0"
            android:progressBackgroundTint="@color/widget_progress_track"
            android:progressTint="@color/widget_progress" />

        <ProgressBar
            android:id="@+id/habitProgress4_progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="24"
            android:indeterminate="false"
            android:max="24"
            android:progress="0"
            android:progressBackgroundTint="@color/widget_progress_track"
            android:progressTint="@color/widget_progress" />

        <ProgressBar
            android:id="@+id/habitProgress5_progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="21"
            android:indeterminate="false"
            android:max="21"
            android:progress="0"
            android:progressBackgroundTint="@color/widget_progress_track"
            android:progressTint="@color/widget_progress" />
    </LinearLayout>

    <TextView
        android:id="@+id/abstinenceTime_textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:lines="1"
        android:textAppearance="?android:attr/textAppearanceSmall"
        tools:text="12d 12h 12m" />
</LinearLayout>
